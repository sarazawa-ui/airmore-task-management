rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // ドメイン制限（①）：許可ドメインのアカウントのみ読み書き可
    //   - 固定5ドメインはルールに直書き（ハードバックストップ）
    //   - 追加ドメインは appConfig/authDomains.domains（admin が UI で管理）
    // =========================================================
    function _fixedDomainOk(email) {
      return email.lower().matches('.*@(nimomakezu\\.com|leaklab-japan\\.com|n-mobily\\.com|n-airmore\\.com|dustlabo\\.com)');
    }
    function _extraDomainOk(email) {
      return exists(/databases/$(database)/documents/appConfig/authDomains)
        && email.lower().split('@')[1] in get(/databases/$(database)/documents/appConfig/authDomains).data.domains;
    }
    function _domainOk() {
      return request.auth != null
        && (_fixedDomainOk(request.auth.token.email) || _extraDomainOk(request.auth.token.email));
    }

    // =========================================================
    // アプリ管理者（admin）：ブートストラップ＋appConfig/admins.emails
    // =========================================================
    function _isAppAdmin(email) {
      return email in ['sarazawa@n-airmore.com', 'sarazawa@leaklab-japan.com']
        || (exists(/databases/$(database)/documents/appConfig/admins)
            && email in get(/databases/$(database)/documents/appConfig/admins).data.emails);
    }

    // === アプリ設定（許可ドメイン・admin 一覧） ===
    //   読み取り：ログイン時のドメイン判定に必要なため認証済みなら可（中身はドメイン/メール一覧のみ）
    //   書き込み：admin のみ
    match /appConfig/{doc} {
      allow read: if request.auth != null;
      // 認証ドメイン・admin一覧の変更は最上位権限(オーナー)のみ
      allow write: if request.auth != null && _isOwner(request.auth.token.email);
    }

    // === Workspace 本体 ===
    // 許可ドメインのユーザーのみ読み書き可（メンバーシップはクライアント側で管理）
    match /workspaces/{wsId} {
      allow read: if _domainOk();
      allow create, update: if _domainOk();
      // ワークスペースの削除は最上位権限(オーナー)のみ
      allow delete: if _domainOk() && _isOwner(request.auth.token.email);

      match /tasks/{doc=**}          { allow read, write: if _domainOk(); }
      match /goals/{doc=**}          { allow read, write: if _domainOk(); }
      match /weeklyReports/{doc=**}  { allow read, write: if _domainOk(); }
      match /history/{doc=**}        { allow read, write: if _domainOk(); }
      // 会議メモの旧置き場所: 新しい置き場所(shared/v3/meetings)へ移行済み。読むだけ(旧版の画面の書き込みは拒否)
      //   削除はワークスペースの削除(オーナー)のために残す
      match /meetings/{doc=**}       { allow read, delete: if _domainOk(); allow create, update: if false; }
      match /shared/{doc}            { allow read, write: if _domainOk(); }   // board / kpt / v3(下の親)

      // === 会議メモ v3(欄ごとの保存 + 文字単位の同時編集) ===
      //   ・本体は欄ごとの update だけ。丸ごと上書き(項目が消える書き込み)・行や参加者を消す書き込み・削除は拒否
      //   ・記録済み(locked)は変更できない(記録の解除もできない)
      //   ・議事録などの変更分(yupd)は追記だけ(書き換え不可)。まとめ(ystate)に含めた分は消してよい
      match /shared/v3/meetings/{mid} {
        allow read: if _domainOk();
        allow create: if _domainOk() && request.resource.data._schema == 3;
        allow update: if _domainOk()
          && request.resource.data._schema == 3
          && resource.data.get('locked', false) != true
          && request.resource.data.diff(resource.data).removedKeys().size() == 0
          && request.resource.data.get('rows', {}).keys().hasAll(resource.data.get('rows', {}).keys())
          && request.resource.data.get('att', {}).keys().hasAll(resource.data.get('att', {}).keys());
        allow delete: if false;

        function _mtLocked() {
          return get(/databases/$(database)/documents/workspaces/$(wsId)/shared/v3/meetings/$(mid)).data.get('locked', false) == true;
        }
        match /yupd/{u} {
          allow read, delete: if _domainOk();
          allow create: if _domainOk() && !_mtLocked();
          allow update: if false;
        }
        match /ystate/{p} { allow read, write: if _domainOk(); }
        match /presence/{p} { allow read, write: if _domainOk(); }
      }
      match /pushTokens/{doc=**}     { allow read, write: if _domainOk(); }

      // === Budget subcollection（旧パス互換） ===
      match /budget/{doc=**} {
        allow read: if _domainOk()
          && _budgetRole(wsId, request.auth.token.email) in ['admin', 'editor', 'viewer'];
        allow write: if _domainOk()
          && _budgetRole(wsId, request.auth.token.email) in ['admin', 'editor'];
      }
    }

    // === Global Budget（WS非依存・全ユーザー共通） ===
    // 許可ドメインのユーザーのみ。ロール細分はアプリ層（AuthGate）で制御
    match /globalBudget/roles {
      allow read: if _domainOk();
      allow write: if _domainOk() && _gbAdminOk(request.auth.token.email);
    }
    match /globalBudget/userCompanies {
      allow read: if _domainOk();
      allow write: if _domainOk();
    }
    match /globalBudget/data {
      allow read: if _domainOk();
      allow write: if _domainOk();
    }
    // Hittatsuの権限(owner/admin/editor)。読取は全員、変更はオーナーのみ
    match /globalBudget/userRoles {
      allow read: if _domainOk();
      allow write: if _domainOk() && _isOwner(request.auth.token.email);
    }
    // 上の個別ルールで制限したドキュメントは、この総括ルールの対象から外す
    // (Firestoreは「どれか1つでも許可すれば通る」ため、除外しないと制限が効かない)
    match /globalBudget/{doc} {
      allow read: if _domainOk();
      allow write: if _domainOk() && !(doc in ["userRoles", "roles"]);
    }

    // === 商談管理：会社（ワークスペース）単位の共有データ ===
    //   案件・商談記録・見積・出張・展示会リード・メンバーを全員で共有する。
    //   プロジェクト管理（workspaces/*）と同じく、許可ドメインのユーザーのみ読み書き可。
    match /salesWs/{wsId} {
      allow read, write: if _domainOk();
      // ※ 会社ごとの商談管理の一覧は sales3 へ移行する。旧版の画面がすべて更新されたら、
      //   ここを「商談の一覧(deals 等)は読むだけ」に変える(次のルール公開で)
      match /{sub=**} { allow read, write: if _domainOk(); }
    }

    // === 商談管理 v3(欄ごとの保存 = スプレッドシート方式) ===
    //   sales3/{会社}              親(設定類 m、移行の印)
    //   sales3/{会社}/{一覧}/{ID}   1件=1ドキュメント
    //   ・欄ごとの update だけを受け付ける(欄を消す=丸ごと上書きの書き込み、文書の削除は拒否。削除は _deleted の印)
    match /sales3/{ws} {
      allow read: if _domainOk();
      allow create: if _domainOk();
      allow update: if _domainOk() && request.resource.data.diff(resource.data).removedKeys().size() == 0;
      allow delete: if false;
      match /{list}/{id} {
        allow read: if _domainOk();
        allow create: if _domainOk() && request.resource.data._schema == 3;
        allow update: if _domainOk()
          && request.resource.data._schema == 3
          && request.resource.data.diff(resource.data).removedKeys().size() == 0;
        allow delete: if false;
      }
    }

    // === 商談管理：会社共有マスタ（得意先・商品・業種） ===
    //   読み書きとも許可ドメインのユーザー（所属会社ごとにドキュメントが分かれる）。
    //   マスタ・設定タブでの一括編集はアプリ側でadminに限定しているが、案件入力中の
    //   マスタ外得意先の登録は全員が行えるようにするため、書込はドメイン全員に許可する。
    match /salesMasters/{cid} {
      allow read, write: if _domainOk();
    }

    // === Budget Access Requests ===
    match /budgetAccessRequests/{email} {
      allow read, write: if _domainOk()
        && request.auth.token.email == email;
      allow read, write: if _domainOk()
        && _gbAdminOk(request.auth.token.email);
    }

    // === sentReminders（Cloud Functions のみ）===
    match /sentReminders/{id} {
      allow read, write: if false;
    }
  }

  // ヘルパ関数：workspaces/{wsId}.budgetRoles[email] を返す（旧パス互換）
  function _budgetRole(wsId, email) {
    return get(/databases/$(database)/documents/workspaces/$(wsId))
      .data.get('budgetRoles', {}).get(email, null);
  }

  // === Global Budget ヘルパ ===
  function _isBootstrapAdmin(email) {
    return email == 'sarazawa@n-airmore.com';
  }
  function _gbRole(email) {
    return exists(/databases/$(database)/documents/globalBudget/roles)
      ? get(/databases/$(database)/documents/globalBudget/roles).data.get('roles', {}).get(email, null)
      : null;
  }
  function _gbReadOk(email) {
    return _isBootstrapAdmin(email) || _gbRole(email) in ['admin', 'editor', 'viewer'];
  }
  function _gbWriteOk(email) {
    return _isBootstrapAdmin(email) || _gbRole(email) in ['admin', 'editor'];
  }
  // 最上位権限(オーナー)。globalBudget/userRoles の map に "owner" と記録された人。
  // 1人も居ない状態でも運用できるよう、初期オーナーを直書きする(アプリ側と同じ)。
  function _isOwner(email) {
    return email.lower() == "sarazawa@n-airmore.com"
      || (exists(/databases/$(database)/documents/globalBudget/userRoles)
          && get(/databases/$(database)/documents/globalBudget/userRoles).data.get("map", {}).get(email.lower(), null) == "owner");
  }
  function _gbAdminOk(email) {
    return _isBootstrapAdmin(email) || _gbRole(email) == 'admin';
  }
}
